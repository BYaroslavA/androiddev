<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photoshop 2.0"
            android:textColor="@color/accent_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/topActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Compare Button (Hold to see original) -->
            <ImageButton
                android:id="@+id/btnCompare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Порівняти з оригіналом"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_body" />

            <!-- Undo Button -->
            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Скасувати дію"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_body" />

            <!-- Redo Button -->
            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Повторити дію"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_body" />

            <!-- Reset Button -->
            <ImageButton
                android:id="@+id/btnReset"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Скинути всі зміни"
                android:src="@drawable/ic_restart_alt"
                app:tint="@color/accent_danger" />

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Поділитися"
                android:src="@drawable/ic_share"
                app:tint="@color/accent_secondary" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Зберегти"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_save"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/bg_dark" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Canvas Preview Area -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_dark"
        android:clipChildren="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomToolContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <ImageView
            android:id="@+id/ivMainImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Редаговане фото"
            android:scaleType="fitCenter" />

        <com.example.myapplication123.CropOverlayView
            android:id="@+id/cropOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- "Оригінал" pill badge when holding Compare button -->
        <TextView
            android:id="@+id/tvCompareBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="ОРИГІНАЛ"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_primary"
            android:visibility="gone" />

        <!-- Empty State (Shown when no image is loaded) -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_chip_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_auto_awesome"
                app:tint="@color/accent_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Фотошоп 2.0"
                android:textColor="@color/text_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Оберіть фото для початку редагування:"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyCamera"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Камера"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_camera"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyGallery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Галерея"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_photo_library"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyWeb"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Інтернет"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_cloud_download"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyDemo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Демо фото"
                    android:textSize="12sp"
                    app:backgroundTint="@color/accent_primary_dark"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_auto_awesome"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />
            </GridLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Crop Floating Controls (Visible during crop mode) -->
    <LinearLayout
        android:id="@+id/cropControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomToolContainer">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCropRatios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCropFree"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Вільна"
                    android:textColor="@color/text_body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop1_1"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1:1 Квадрат"
                    android:textColor="@color/text_body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop4_3"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:3 Фото"
                    android:textColor="@color/text_body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop16_9"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:9 Широкий"
                    android:textColor="@color/text_body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop9_16"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9:16 Сторіс"
                    android:textColor="@color/text_body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCrop3_4"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3:4 Портрет"
                    android:textColor="@color/text_body" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCrop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Скасувати"
                android:textColor="@color/accent_danger"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/accent_danger"
                app:strokeColor="@color/accent_danger" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCrop"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Обрізати"
                android:textColor="@color/bg_dark"
                app:backgroundTint="@color/accent_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/bg_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Tool Container -->
    <LinearLayout
        android:id="@+id/bottomToolContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_panel"
        android:orientation="vertical"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tool Content Area (Switched by Tabs) -->
        <FrameLayout
            android:id="@+id/toolContentArea"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:paddingHorizontal="16dp">

            <!-- 1. Filters Panel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- 2. Adjustments Panel -->
            <LinearLayout
                android:id="@+id/panelAdjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Slider Selector Chips (Brightness, Contrast, Saturation) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAdjust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBrightness"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Яскравість (0)"
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipContrast"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Контраст (0)"
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSaturation"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Насиченість (0)"
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Active Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAdjustMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-100"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAdjust"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:value="0"
                        android:valueFrom="-100"
                        android:valueTo="100"
                        app:thumbColor="@color/accent_primary"
                        app:trackColorActive="@color/accent_primary"
                        app:trackColorInactive="@color/slider_track" />

                    <TextView
                        android:id="@+id/tvAdjustMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Geometry / Transform Panel -->
            <LinearLayout
                android:id="@+id/panelTransform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRotateLeft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="-90°"
                    android:textColor="@color/text_body"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_rotate_left"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRotateRight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="+90°"
                    android:textColor="@color/text_body"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_rotate_right"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlipH"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Дзеркало Г"
                    android:textColor="@color/text_body"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_flip"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlipV"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Дзеркало В"
                    android:textColor="@color/text_body"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_flip_vertical"
                    app:iconSize="20dp" />
            </LinearLayout>

            <!-- 4. Crop Launcher Panel -->
            <LinearLayout
                android:id="@+id/panelCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartCrop"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="220dp"
                    android:layout_height="48dp"
                    android:text="Увімкнути режим обрізки"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_crop"
                    app:iconSize="20dp"
                    app:iconTint="@color/bg_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Підтримуються формати: 1:1, 4:3, 16:9, 9:16 та вільний"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 5. Effects Panel (Vignette) -->
            <LinearLayout
                android:id="@+id/panelEffects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVignetteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Віньєтка: 0%"
                    android:textColor="@color/text_body"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderVignette"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:thumbColor="@color/accent_primary"
                        app:trackColorActive="@color/accent_primary"
                        app:trackColorInactive="@color/slider_track" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/divider_line" />

        <!-- Navigation Tabs: Filters, Adjust, Geometry, Crop, Effects -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tabFilters"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Фільтри"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabAdjust"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Корекція"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTransform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Геометрія"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Обрізка"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabEffects"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ефекти"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_line" />

        <!-- Bottom Source Bar (Camera, Gallery, Web, Demo) -->
        <LinearLayout
            android:id="@+id/sourceBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
