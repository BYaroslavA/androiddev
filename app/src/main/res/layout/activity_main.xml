<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4F0"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════ HERO SECTION ═══════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            android:padding="28dp">

            <!-- Tag -->
            <TextView
                android:id="@+id/hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#2D2D2D"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="FITNESS · WELLNESS · 2026"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <!-- Badge FREE -->
            <TextView
                android:id="@+id/hero_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="#2D6A4F"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="FREE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-bold" />

            <!-- Big title: Move -->
            <TextView
                android:id="@+id/hero_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/hero_tag"
                android:layout_marginTop="40dp"
                android:text="Move"
                android:textColor="#D1D5DB"
                android:textSize="56sp"
                android:fontFamily="sans-serif-light" />

            <!-- Big title: Better. -->
            <TextView
                android:id="@+id/hero_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/hero_title_1"
                android:text="Better."
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:fontFamily="sans-serif-black" />

            <!-- Green underline accent -->
            <View
                android:id="@+id/hero_accent_line"
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:layout_below="@id/hero_title_2"
                android:layout_marginTop="12dp"
                android:background="#40916C" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/hero_accent_line"
                android:layout_marginTop="20dp"
                android:text="Track your workouts, monitor your progress and reach your goals — all in one clean app."
                android:textColor="#9CA3AF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif" />

            <!-- CTA button -->
            <TextView
                android:id="@+id/hero_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/hero_subtitle"
                android:layout_marginTop="32dp"
                android:background="#2D6A4F"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:text="GET STARTED"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-bold" />

            <!-- Secondary link -->
            <TextView
                android:id="@+id/hero_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/hero_cta"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Learn more ↓"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

        </RelativeLayout>

        <!-- ═══════════ STATS SECTION ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:padding="24dp">

            <!-- Stat 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="48K"
                    android:textColor="#1A1A1A"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Users"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="#E5E7EB" />

            <!-- Stat 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.2M"
                    android:textColor="#1A1A1A"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Workouts"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="#E5E7EB" />

            <!-- Stat 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9 ★"
                    android:textColor="#2D6A4F"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rating"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ FEATURES SECTION ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F4F0"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT YOU GET"
                android:textColor="#2D6A4F"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Everything\nyou need."
                android:textColor="#1A1A1A"
                android:textSize="34sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif-black" />

            <!-- Feature Card 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#ECFDF5"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Tracking"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Automatically detects your workout type and logs every rep."
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Feature Card 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#ECFDF5"
                    android:gravity="center"
                    android:text="📊"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress Charts"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Beautiful graphs to keep you motivated week after week."
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Feature Card 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#ECFDF5"
                    android:gravity="center"
                    android:text="🎯"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal Setting"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Set custom goals and get notified when you hit a milestone."
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Feature Card 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#ECFDF5"
                    android:gravity="center"
                    android:text="💤"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recovery Mode"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rest day reminders and sleep insights to recover faster."
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════ QUOTE SECTION ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D6A4F"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❝"
                android:textColor="#40916C"
                android:textSize="40sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="The only bad workout is the one that didn't happen."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="— Built for real people"
                android:textColor="#B7E4C7"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- ═══════════ PLAN SECTION ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F4F0"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRICING"
                android:textColor="#2D6A4F"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Simple plans."
                android:textColor="#1A1A1A"
                android:textSize="34sp"
                android:fontFamily="sans-serif-black" />

            <!-- Free card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFFFFF"
                android:padding="20dp">

                <TextView
                    android:id="@+id/plan_free_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/plan_free_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="$0"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/plan_free_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/plan_free_title"
                    android:layout_marginTop="10dp"
                    android:text="✓  Unlimited workouts\n✓  Basic charts\n✓  3 active goals"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </RelativeLayout>

            <!-- Pro card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#1A1A1A"
                android:padding="20dp">

                <TextView
                    android:id="@+id/plan_pro_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pro"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/plan_pro_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/plan_pro_title"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="2dp"
                    android:background="#2D6A4F"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="POPULAR"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/plan_pro_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="$4.99/mo"
                    android:textColor="#40916C"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/plan_pro_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/plan_pro_title"
                    android:layout_marginTop="10dp"
                    android:text="✓  Everything in Free\n✓  Advanced analytics\n✓  Unlimited goals\n✓  AI coach suggestions"
                    android:textColor="#D1D5DB"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- ═══════════ BOTTOM CTA SECTION ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Start your\njourney today."
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Join 48,000+ users already moving better."
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="#2D6A4F"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:text="DOWNLOAD NOW"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="See all features"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- ═══════════ FOOTER ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOVE BETTER"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-black" />

            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:background="#2D6A4F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="© 2026 · All rights reserved"
                android:textColor="#4B5563"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
